{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "rootDir": "./",
    "paths": {
      "@shared/*": ["../shared/src/*"],
      "#*": ["./src/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["dist"],
  "references": [{ "path": "../shared" }]
}
